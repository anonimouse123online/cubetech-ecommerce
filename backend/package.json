{
  "name": "cartlane-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.js",
    "start": "node --experimental-strip-types src/server.js",
    "test": "node --experimental-strip-types test/run-tests.js",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "node node_modules/prisma/build/index.js migrate dev",
    "db:seed": "node --experimental-strip-types prisma/seed.js",
    "db:studio": "node node_modules/prisma/build/index.js studio"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  }
}
